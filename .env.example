# Docker Compose PostgreSQL settings. Change the demo password before exposing
# this deployment beyond your own machine. Use URL-safe characters in it.
POSTGRES_DB=agenttree_studio
POSTGRES_USER=agenttree
POSTGRES_PASSWORD=agenttree_dev_only

# Published on all host interfaces for trusted LAN access. Restrict inbound
# TCP 5173/8000 with your host/network firewall as appropriate. PostgreSQL
# stays private to the Compose network.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Optional stable Fernet key. If blank, the backend generates one once in the
# named studio_key volume. Back up that volume with the PostgreSQL volume.
# For direct local development, generate a key and set it here:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AGENTTREE_STUDIO_ENCRYPTION_KEY=

# Direct local development still defaults to SQLite when this is unset.
# Docker Compose constructs a PostgreSQL URL from POSTGRES_* above and does not
# read this value, so local and containerized configurations cannot conflict.
AGENTTREE_STUDIO_DATABASE_URL=

# On a genuinely fresh database, blank values bootstrap admin/admin and force
# an immediate password change. Set a unique 12+ character password here to
# override it. Existing Admin passwords are never reset by these values.
AGENTTREE_STUDIO_ADMIN_USERNAME=admin
AGENTTREE_STUDIO_ADMIN_PASSWORD=

# Set true when Studio is served through HTTPS and the backend cannot detect
# the external TLS scheme through a trusted reverse proxy.
AGENTTREE_STUDIO_SECURE_COOKIES=false

# Optional browser origins for Bearer-only Public APIs v1 and v2; comma-separated.
# Do not use '*'. Server-side/CLI clients do not need CORS.
AGENTTREE_PUBLIC_API_CORS_ORIGINS=

# Optional public HTTPS Studio origin used by Connect examples and webhook URLs.
# When unset, Connect uses the browser's origin (including the frontend /api proxy).
AGENTTREE_STUDIO_PUBLIC_ORIGIN=

# Durable local artifact bodies. Put this directory on persistent storage and
# back it up with PostgreSQL. Logical artifact paths are never used on disk.
AGENTTREE_STUDIO_ARTIFACT_ROOT=
AGENTTREE_STUDIO_MAX_ARTIFACT_BYTES=10485760
