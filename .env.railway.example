# Backend service: placeholders only. Set as Railway service variables.
AGENTTREE_STUDIO_DEPLOYMENT=railway
DATABASE_URL=${{Postgres.DATABASE_URL}}
AGENTTREE_STUDIO_ENCRYPTION_KEY=<stable Fernet key>
AGENTTREE_STUDIO_ADMIN_USERNAME=<unique bootstrap username>
AGENTTREE_STUDIO_ADMIN_PASSWORD=<unique 12+ character bootstrap password>
AGENTTREE_STUDIO_ARTIFACT_ROOT=/data/artifacts
AGENTTREE_STUDIO_PUBLIC_ORIGIN=https://<frontend-domain>
AGENTTREE_STUDIO_SECURE_COOKIES=true

# Frontend service variables. Use the backend's actual private DNS name and PORT.
BACKEND_INTERNAL_URL=http://<backend-service>.railway.internal:8000
